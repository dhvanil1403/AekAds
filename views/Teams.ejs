<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="icon" type="image/png" href="https://res.cloudinary.com/dqfnwh89v/image/upload/v1724408615/qxvvfcf7ftgklhl2k03v.png">
    <link rel="stylesheet" href="/css/playlist.css" />
  <link rel="stylesheet" href="/css/font.css" />
    <link rel="stylesheet" href="/css/teams.css" />
  </head>
  <body>
    <%- include('Dashboard') %>
    <div class="teams">
      <div class="home-playlist">
        <p>Home><b>Dashboard</b></p>
    </div>

    <div class="member">
      <div class="members" id="members">
        Members
      </div>
      <div class="New-members" id="newMembers">
        New Member
      </div>
      <!-- <div class="Logs" id="logs">
        Logs
      </div> -->
    </div>
    <script>
      document.getElementById("members").addEventListener("click", function () {
        window.location.href = "/admin/users";
      });
      document.getElementById("newMembers").addEventListener("click", function () {
        window.location.href = "/Dashboard/Teams/Addmember";
      });
     
    </script>

       <div class="member-form">
        <form action="/Dashboard/Teams/Addmember" method="post">
         <div class="form">
          <% if (message) { %>
            <p><%= message %></p>
          <% } %>
            <div class="formdata">
                <label>Member Name</label>
                <input type="text" required name="memberName" />
              </div>
              <div class="formdata">
                <label>Member Email</label>
                <input type="email" required name="memberEmail" />
              </div>
              <div class="formdata">
                <label>Select Role</label>
                <select name="role">
                  <option value="Editor">Editor</option>
                  <option value="Admin">Admin</option>
                  <option value="Viewer">Viewer</option>
                  <option value="sales">Sales</option>
                </select>
              </div>
              <div class="formdata">
                <label>Login Password</label>
                <input type="password" required name="memberPassword" />
              </div>
              <div class="formdata btn">
                <input type="submit" value="Add member"  />
              </div>
         </div>
        </form>
      </div> 

      
    </div>
    <script>
      // Flag to track internal navigation
      let isNavigatingInternal = false;
    
      // Reset the flag for internal navigation on link click
      document.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", (event) => {
              const destination = event.target.closest("a").href;
    
              // Check if the link is for internal navigation
              if (destination.includes("/Dashboard")) {
                  isNavigatingInternal = true; // Set flag to avoid the alert
              }
          });
      });
    
      // // Listen for beforeunload event
      // window.addEventListener("beforeunload", (event) => {
      //     if (!isNavigatingInternal) {
      //         // Trigger the alert for closing or refreshing the tab
      //         const confirmationMessage = "Are you sure you want to leave? This will log you out.";
      //         event.preventDefault(); // For modern browsers
      //         event.returnValue = confirmationMessage; // Compatibility with older browsers
    
      //         // Return the message (used for legacy browser support)
      //         return confirmationMessage;
      //     }
      // });
    
      // Detect when the window is being unloaded
      window.addEventListener("unload", async () => {
          if (!isNavigatingInternal) {
              // Make a logout request if the tab is closed
              await fetch('/logout', {
                  method: 'GET',
                  credentials: 'include', // Send cookies along with the request
              });
          }
      });
    
      // Reset flag after page has finished navigating
      window.addEventListener("pageshow", () => {
          isNavigatingInternal = false;
      });
    </script>
  </body>
</html>
